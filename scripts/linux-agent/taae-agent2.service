[Unit]
Description=TAAE Agent 2 (TAAE monitoring agent)
Documentation=https://taae.local/docs
After=network-online.target syslog.target
Wants=network-online.target

[Service]
Type=simple
User=taae-agent
Group=taae-agent
EnvironmentFile=-/etc/taae/agent/taae_agent2.env
ExecStart=/usr/sbin/taae_agent2 -f -c /etc/taae/agent/taae_agent2.conf
ExecReload=/bin/kill -HUP $MAINPID
RuntimeDirectory=taae/agent
RuntimeDirectoryMode=0750
LogsDirectory=taae/agent
LogsDirectoryMode=0750
StateDirectory=taae/agent
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
